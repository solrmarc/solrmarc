<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="**/*.cup|**/*.lex" kind="src" path="src"/>
	<classpathentry excluding="org/solrmarc/mixin/DlMixin.java|org/solrmarc/mixin/AbstractFullRecordMultiValueExtractor.java" kind="src" output="test/build" path="test/src"/>
	<classpathentry kind="lib" path="lib/bsh-2.0b5.jar"/>
	<classpathentry kind="lib" path="lib/java-cup-11b-runtime.jar"/>
	<classpathentry kind="lib" path="lib/miglayout15-swing.jar"/>
	<classpathentry kind="lib" path="lib/jopt-simple-5.0.2.jar"/>
	<classpathentry kind="lib" path="lib-solrj/apache-solr-solrj-3.5-Multiversion.jar" sourcepath="/solrj/src"/>
	<classpathentry kind="lib" path="lib-solrj/commons-codec-1.3.jar"/>
	<classpathentry kind="lib" path="lib-solrj/commons-httpclient-3.1.jar"/>
	<classpathentry kind="lib" path="test/lib/hamcrest-all-1.3.jar"/>
	<classpathentry kind="lib" path="lib/classgraph-4.1.6.jar"/>
	<classpathentry kind="lib" path="lib/marc4j-2.9.8.jar"/>
	<classpathentry kind="lib" path="lib/reload4j-1.2.25.jar"/>
	<classpathentry kind="lib" path="lib/slf4j-api-2.0.9.jar"/>
	<classpathentry kind="lib" path="lib/slf4j-reload4j-2.0.9.jar"/>
	<classpathentry kind="lib" path="test/lib/mockito-core-4.11.0.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="test/lib/junit-4.12.jar"/>
	<classpathentry kind="output" path="build"/>
</classpath>
